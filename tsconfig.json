{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@workspace/db": ["./src/db/index.ts"],
      "@workspace/db/*": ["./src/db/*"],
      "@workspace/api-zod": ["./src/api-zod/index.ts"],
      "@workspace/api-zod/*": ["./src/api-zod/*"]
    }
  },
  "include": ["src/**/*"]
}
